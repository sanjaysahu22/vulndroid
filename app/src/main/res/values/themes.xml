<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.VulnDroid" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/vd_bg</item>
        <item name="android:colorAccent">@color/vd_primary</item>
        <item name="android:colorPrimary">@color/vd_primary</item>
        <item name="android:colorPrimaryDark">@color/vd_bg_deep</item>
        <item name="android:statusBarColor">@color/vd_bg_deep</item>
        <item name="android:navigationBarColor">@color/vd_bg_deep</item>
        <item name="android:textColorPrimary">@color/vd_text</item>
        <item name="android:textColorSecondary">@color/vd_text_muted</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="VdSectionLabel">
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.14</item>
        <item name="android:textColor">@color/vd_text_faint</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="VdBody">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/vd_text_muted</item>
        <item name="android:lineSpacingExtra">5dp</item>
    </style>

    <style name="VdBodyStrong">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/vd_text</item>
        <item name="android:lineSpacingExtra">5dp</item>
    </style>

    <style name="VdMono">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/vd_primary</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:lineSpacingExtra">4dp</item>
        <item name="android:textIsSelectable">true</item>
    </style>

    <style name="VdButton" parent="@android:style/Widget.Material.Button">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">#04151F</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.03</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingLeft">18dp</item>
        <item name="android:paddingRight">18dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="VdButtonSecondary" parent="@android:style/Widget.Material.Button">
        <item name="android:background">@drawable/bg_button_secondary</item>
        <item name="android:textColor">@color/vd_text</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingLeft">18dp</item>
        <item name="android:paddingRight">18dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="VdInput" parent="@android:style/Widget.Material.EditText">
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:textColor">@color/vd_text</item>
        <item name="android:textColorHint">@color/vd_text_faint</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:padding">14dp</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="VdChip">
        <item name="android:textSize">10sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:paddingLeft">10dp</item>
        <item name="android:paddingRight">10dp</item>
        <item name="android:paddingTop">5dp</item>
        <item name="android:paddingBottom">5dp</item>
    </style>

    <style name="VdIconButton" parent="@android:style/Widget.Material.Button.Borderless">
        <item name="android:background">@drawable/bg_icon_button</item>
        <item name="android:textColor">@color/vd_text</item>
        <item name="android:textSize">22sp</item>
        <item name="android:minWidth">44dp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
</resources>
