<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/vd_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="12dp"
        android:background="@color/vd_bg_deep">

        <Button
            android:id="@+id/deepClose"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:text="✕"
            style="@style/VdIconButton" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="12dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="DeepLinkActivity"
                android:textColor="@color/vd_text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Result of routing an incoming URI"
                android:textColor="@color/vd_text_faint"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/deepBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:fontFamily="monospace"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="INCOMING URI"
                style="@style/VdSectionLabel" />

            <TextView
                android:id="@+id/deepIncomingUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_code"
                android:fontFamily="monospace"
                android:padding="14dp"
                android:textColor="@color/vd_primary"
                android:textIsSelectable="true"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical"
                android:padding="18dp"
                android:background="@drawable/bg_card">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="OUTCOME"
                    style="@style/VdSectionLabel" />

                <TextView
                    android:id="@+id/deepResultTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/vd_text"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/deepResultMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/vd_text_muted"
                    android:textSize="13sp"
                    android:lineSpacingExtra="4dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="EXPOSED / RETURNED DATA"
                    style="@style/VdSectionLabel" />

                <TextView
                    android:id="@+id/deepExposed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_code"
                    android:fontFamily="monospace"
                    android:padding="14dp"
                    android:textColor="@color/vd_text_muted"
                    android:textIsSelectable="true"
                    android:textSize="11.5sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="POLICY CHECKS"
                    style="@style/VdSectionLabel" />

                <TextView
                    android:id="@+id/deepChecks"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/vd_text_faint"
                    android:textSize="12sp" />
            </LinearLayout>

            <Button
                android:id="@+id/deepRetrySignedIn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="RETRY AS A SIGNED-IN USER"
                style="@style/VdButtonSecondary" />

            <Button
                android:id="@+id/deepDone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="CLOSE"
                style="@style/VdButton" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
