<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/vd_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:background="@color/vd_bg_deep">

        <Button
            android:id="@+id/labBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:text="←"
            style="@style/VdIconButton" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/labKicker"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="LAB"
                style="@style/VdSectionLabel" />

            <TextView
                android:id="@+id/labTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Lab"
                android:textColor="@color/vd_text"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/labStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/VdChip" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp"
                android:background="@drawable/bg_card">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/section_intro"
                    style="@style/VdSectionLabel" />

                <TextView
                    android:id="@+id/labIntro"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    style="@style/VdBody" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="@string/section_vulnerability"
                style="@style/VdSectionLabel" />

            <TextView
                android:id="@+id/labVulnerability"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                style="@style/VdBody" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="@string/section_demo"
                style="@style/VdSectionLabel" />

            <LinearLayout
                android:id="@+id/labDemoCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:padding="18dp"
                android:background="@drawable/bg_card" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="@string/section_testing"
                style="@style/VdSectionLabel" />

            <TextView
                android:id="@+id/labTesting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                style="@style/VdBody" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="@string/section_observed"
                style="@style/VdSectionLabel" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:padding="18dp"
                android:background="@drawable/bg_card">

                <LinearLayout
                    android:id="@+id/labObservedHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/labObservedHeadline"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/observed_empty"
                        android:textColor="@color/vd_text"
                        android:textSize="14sp"
                        android:lineSpacingExtra="4dp" />

                    <ProgressBar
                        android:id="@+id/labProgress"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginLeft="10dp"
                        android:indeterminateTint="@color/vd_primary"
                        android:visibility="gone" />
                </LinearLayout>

                <TextView
                    android:id="@+id/labObservedTime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/vd_text_faint"
                    android:textSize="10sp"
                    android:fontFamily="monospace" />

                <TextView
                    android:id="@+id/labEvidenceLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="EVIDENCE"
                    android:visibility="gone"
                    style="@style/VdSectionLabel" />

                <TextView
                    android:id="@+id/labEvidence"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_code"
                    android:fontFamily="monospace"
                    android:padding="14dp"
                    android:textColor="@color/vd_primary"
                    android:textIsSelectable="true"
                    android:textSize="11sp"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/labRetest"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/run_retest"
                    style="@style/VdButton" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="@string/section_secure"
                style="@style/VdSectionLabel" />

            <TextView
                android:id="@+id/labSecure"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                style="@style/VdBody" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="@string/section_summary"
                style="@style/VdSectionLabel" />

            <TextView
                android:id="@+id/labSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/vd_text"
                android:textSize="14sp"
                android:lineSpacingExtra="5dp" />

            <TextView
                android:id="@+id/labBuildFooter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="12dp"
                android:fontFamily="monospace"
                android:textColor="@color/vd_text_faint"
                android:textSize="10sp"
                android:lineSpacingExtra="3dp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
