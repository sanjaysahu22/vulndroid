<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Feed a URI to the app's link handler. The admin action is the highest-impact test; the profile link demonstrates data exposure."
        android:textColor="@color/vd_text_muted"
        android:textSize="13sp"
        android:lineSpacingExtra="4dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="DEEP LINK URL"
        style="@style/VdSectionLabel" />

    <EditText
        android:id="@+id/deepUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:hint="vulndroid://profile?id=2"
        android:inputType="textUri"
        android:singleLine="true"
        android:text="vulndroid://admin/approve?txn=TXN-1042"
        style="@style/VdInput" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/deepPresetAdmin"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="ADMIN LINK"
            style="@style/VdButtonSecondary" />

        <Button
            android:id="@+id/deepPresetProfile"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_weight="1"
            android:text="PROFILE LINK"
            style="@style/VdButtonSecondary" />
    </LinearLayout>

    <CheckBox
        android:id="@+id/deepAuthenticated"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:buttonTint="@color/vd_primary"
        android:text="Simulate an authenticated in-app session"
        android:textColor="@color/vd_text_muted"
        android:textSize="13sp" />

    <Button
        android:id="@+id/deepSimulate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="SIMULATE INCOMING LINK"
        style="@style/VdButton" />

    <TextView
        android:id="@+id/deepOutput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_code"
        android:fontFamily="monospace"
        android:padding="14dp"
        android:text="No link simulated yet."
        android:textColor="@color/vd_primary"
        android:textIsSelectable="true"
        android:textSize="11.5sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="The real attack uses another app that claims the same custom scheme, or a web page that navigates to the link. Use the VulnDroid Attacker app to register a competing handler."
        android:textColor="@color/vd_text_faint"
        android:textSize="11sp" />
</LinearLayout>
