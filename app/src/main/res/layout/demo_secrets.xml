<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="DemoService client"
        android:textColor="@color/vd_text"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="https://api.vulndroid.example/v1/accounts"
        android:fontFamily="monospace"
        android:textColor="@color/vd_text_muted"
        android:textSize="12sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="AUTHENTICATION MATERIAL IN THIS BUILD"
        style="@style/VdSectionLabel" />

    <TextView
        android:id="@+id/secretsMaskedKey"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_code"
        android:fontFamily="monospace"
        android:padding="14dp"
        android:text="checking…"
        android:textColor="@color/vd_primary"
        android:textIsSelectable="true"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/secretsModeNote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text=""
        android:textColor="@color/vd_text_faint"
        android:textSize="12sp" />

    <Button
        android:id="@+id/secretsExtract"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="EXTRACT SECRET FROM THIS APK"
        style="@style/VdButton" />

    <Button
        android:id="@+id/secretsCall"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="SIMULATE AUTHENTICATED API CALL"
        style="@style/VdButtonSecondary" />

    <TextView
        android:id="@+id/secretsOutput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_code"
        android:fontFamily="monospace"
        android:padding="14dp"
        android:textColor="@color/vd_primary"
        android:textIsSelectable="true"
        android:textSize="11.5sp"
        android:visibility="gone" />
</LinearLayout>
