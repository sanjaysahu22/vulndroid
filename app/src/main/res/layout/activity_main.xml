<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vd_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:paddingTop="18dp"
            android:paddingBottom="12dp">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/ic_shield"
                android:contentDescription="VulnDroid"
                android:tint="@color/vd_primary" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginLeft="10dp"
                android:text="VULNDROID"
                android:textColor="@color/vd_text"
                android:textSize="15sp"
                android:textStyle="bold"
                android:letterSpacing="0.18" />

            <TextView
                android:id="@+id/mainBuildBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BUILD"
                style="@style/VdChip" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="22dp"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp"
            android:background="@drawable/bg_hero">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ANDROID  ·  SECURITY  ·  TRAINING"
                style="@style/VdSectionLabel" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Five ways mobile\napps break."
                android:textColor="@color/vd_text"
                android:textSize="32sp"
                android:textStyle="bold"
                android:lineSpacingExtra="0dp"
                android:fontFamily="sans-serif-black" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/dashboard_subtitle"
                android:textColor="@color/vd_text_muted"
                android:textSize="14sp"
                android:lineSpacingExtra="5dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="5 LABS  ·  LIVE TESTS  ·  SECURE BUILD INCLUDED"
                android:fontFamily="monospace"
                android:textColor="@color/vd_primary"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp"
            android:layout_marginTop="14dp"
            android:padding="14dp"
            android:background="@drawable/bg_card_soft">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_info"
                android:tint="@color/vd_amber"
                android:contentDescription="Safety" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginLeft="10dp"
                android:text="@string/safety_notice"
                android:textColor="@color/vd_text_muted"
                android:textSize="11.5sp"
                android:lineSpacingExtra="3dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp"
            android:layout_marginTop="26dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/labs_heading"
                style="@style/VdSectionLabel" />

            <TextView
                android:id="@+id/mainProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 / 5 TESTED"
                android:fontFamily="monospace"
                android:textColor="@color/vd_text_faint"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/mainLabList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp"
            android:layout_marginTop="10dp"
            android:orientation="vertical" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp"
            android:layout_marginTop="14dp"
            android:padding="18dp"
            android:background="@drawable/bg_card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_terminal"
                    android:tint="@color/vd_secondary"
                    android:contentDescription="Tools" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:text="@string/field_kit_heading"
                    style="@style/VdSectionLabel" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/field_kit_text"
                android:textColor="@color/vd_text_muted"
                android:textSize="13sp"
                android:lineSpacingExtra="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="monospace"
                android:text="JADX  ·  MOBSF  ·  ADB  ·  BURP SUITE"
                android:textColor="@color/vd_secondary"
                android:textSize="10sp" />
        </LinearLayout>

        <Button
            android:id="@+id/mainReport"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp"
            android:layout_marginTop="14dp"
            android:text="@string/open_report"
            style="@style/VdButton" />

        <Button
            android:id="@+id/mainAbout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp"
            android:layout_marginTop="8dp"
            android:text="@string/open_about"
            style="@style/VdButtonSecondary" />

        <TextView
            android:id="@+id/mainVersion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="28dp"
            android:fontFamily="monospace"
            android:textColor="@color/vd_text_faint"
            android:textSize="10sp"
            android:lineSpacingExtra="3dp" />
    </LinearLayout>
</ScrollView>
