<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.VulnDroidAttacker" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/atk_bg</item>
        <item name="android:statusBarColor">@color/atk_bg</item>
        <item name="android:navigationBarColor">@color/atk_bg</item>
        <item name="android:colorAccent">@color/atk_red</item>
        <item name="android:textColorPrimary">@color/atk_text</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>
    <style name="AtkButton" parent="@android:style/Widget.Material.Button">
        <item name="android:background">@drawable/bg_button</item>
        <item name="android:textColor">#1A070B</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    <style name="AtkButtonSecondary" parent="@android:style/Widget.Material.Button">
        <item name="android:background">@drawable/bg_button_secondary</item>
        <item name="android:textColor">@color/atk_text</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
</resources>
